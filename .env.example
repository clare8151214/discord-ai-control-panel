# Discord Developer Portal 的 Bot Token（不要公開或提交到 Git）
DISCORD_TOKEN=

# 可選：開發階段填入 Discord 伺服器 ID，該伺服器會立即同步；全域指令仍會註冊
DISCORD_GUILD_ID=

# 多人自動對話需要先在 Discord Developer Portal 開啟 Message Content Intent
MESSAGE_CONTENT_INTENT=false

# 建議用 run-windows.ps1 啟動 Bot，這樣 localhost 會連到 Windows Ollama
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=gemma4:12b-it-qat

# CLI 可選：以 JSON array 定義任意數量的 Ollama / OpenAI 相容 / Gemini / Anthropic 原生 Provider。
# 設定後取代上面的 legacy Provider 清單；API Key 不應提交 Git。
# GUI 會為每個 Bot 自動產生這個變數，不需手動填寫。
# AI_PROVIDERS_JSON=[{"id":"cloud","name":"Cloud API","type":"openai","base_url":"https://api.example.com/v1","api_key":"","models":["model-name"]}]
# Claude 原生 API：type="anthropic", base_url="https://api.anthropic.com/v1"，模型名稱可由 GUI 連線後讀取。

# 預設不傳送自訂 system prompt；可啟動後使用 /system 設定
DEFAULT_SYSTEM_PROMPT=

OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_TEMPERATURE=0.7
OLLAMA_KEEP_ALIVE=-1
# 限制失控長回答；縮短等待時間但仍足夠一般聊天與角色扮演
CHAT_MAX_OUTPUT_TOKENS=768
MAX_HISTORY_MESSAGES=40

# 房間記憶：保留回答空間、達門檻自動摘要，原文另存 SQLite 7 天
# 留空時：Windows 存在 %LOCALAPPDATA%\OllamaDiscordBot；Linux 存在 ./data
DATABASE_FILE=
# 每則 SQLite 原始對話只保留 7 天；Bot 啟動時及每小時自動清理
ARCHIVE_RETENTION_DAYS=7
ARCHIVE_CLEANUP_INTERVAL_SECONDS=3600
MEMORY_OUTPUT_RESERVE=1536
MEMORY_COMPACT_TRIGGER=0.70
MEMORY_RECENT_MESSAGES=8
MEMORY_SUMMARY_MAX_TOKENS=1024
MEMORY_SUMMARY_MAX_CHARS=4000

ADMIN_ONLY_SETTINGS=true
LOG_LEVEL=INFO

# 文字轉語音（/tts enable 後生效；使用微軟 Edge TTS 免費雲端，不佔本機 GPU）
# 常用聲音：zh-TW-HsiaoChenNeural（台灣女聲）、zh-TW-YunJheNeural（台灣男聲）
TTS_DEFAULT_VOICE=zh-TW-HsiaoChenNeural
# 單次朗讀最大字元數；超過會在句尾截斷並提示改看文字
TTS_MAX_CHARS=1000

# 情境生圖（遠端 ComfyUI；使用 /image enable 逐頻道開啟）
COMFYUI_URL=
COMFYUI_CHECKPOINT=NoobAI-XL-v1.1.safetensors
COMFYUI_WIDTH=896
COMFYUI_HEIGHT=896
COMFYUI_STEPS=20
COMFYUI_CFG=5.5
COMFYUI_TIMEOUT=600
# 角色一致性：NoobAI 專用 IP-Adapter 與其 CLIP Vision encoder
IPADAPTER_MODEL=ip_adapter_Noobtest_800000.bin
CLIP_VISION_MODEL=CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors
IPADAPTER_DEFAULT_WEIGHT=0.65
IPADAPTER_END_AT=0.8
# 留空時 Windows 存在 %LOCALAPPDATA%\OllamaDiscordBot\characters
CHARACTER_ASSET_DIR=
CHARACTER_REFERENCE_MAX_BYTES=10000000
# 最近生成的 latest 候選圖保留 2 天；人工核准 reference 永不自動刪除
IMAGE_RETENTION_DAYS=2
IMAGE_CLEANUP_INTERVAL_SECONDS=86400
# 聊天模型把中文情境轉為英文視覺標籤時的輸出上限
IMAGE_PROMPT_MAX_TOKENS=180
IMAGE_PROMPT_SOURCE_MAX_CHARS=3500
# 預留低於 Discord 一般 10MB 上傳限制的安全值
IMAGE_MAX_BYTES=9500000

# 可選:第二台 Ollama(區網另一台機器);留空表示不啟用 ollama-remote Provider
# OLLAMA_REMOTE_URL=http://192.168.x.x:11434
